{
  "name": "grantline-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "docs:build": "vitepress build ../docs",
    "build:all": "pnpm build && pnpm docs:build",
    "dev": "vite --host 127.0.0.1",
    "check-render": "vite build --ssr src/components.tsx --outDir .test-output && node scripts/check-render.mjs",
    "format": "prettier --write src"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitepress": "1.6.4",
    "vue": "^3.5.43"
  },
  "packageManager": "pnpm@11.19.0"
}
