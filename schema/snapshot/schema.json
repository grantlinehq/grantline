{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/grantline/schema/snapshot/1.0",
  "title": "Grantline offline snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "collected_at",
    "entities",
    "relationships",
    "evidence",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "provenance": {
      "enum": [
        "live_api",
        "provider_export",
        "synthetic_fixture"
      ]
    },
    "assertion_kind": {
      "enum": [
        "observed",
        "configured",
        "declared",
        "inferred"
      ]
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "source_id",
        "native_id",
        "scope",
        "name",
        "attributes",
        "field_status",
        "observed_at",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "source_id": {
          "type": "string"
        },
        "native_id": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "attributes": {
          "type": "object"
        },
        "field_status": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "known",
              "unknown",
              "permission_denied",
              "unsupported"
            ]
          }
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to",
        "type",
        "assertion_kind",
        "evidence_ids",
        "scope",
        "observed_at"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "assertion_kind": {
          "$ref": "#/$defs/assertion_kind"
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "scope": {
          "type": "string"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_id",
        "native_id",
        "locator",
        "fields",
        "observed_at",
        "assertion_kind"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "source_id": {
          "type": "string"
        },
        "native_id": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "assertion_kind": {
          "$ref": "#/$defs/assertion_kind"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "scope",
        "status",
        "complete",
        "permissions_observed",
        "warnings",
        "pagination_complete",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "kubernetes",
            "vault",
            "jenkins",
            "github",
            "entra",
            "spire"
          ]
        },
        "scope": {
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "partial",
            "error",
            "disabled",
            "unsupported"
          ]
        },
        "complete": {
          "type": "boolean"
        },
        "permissions_observed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pagination_complete": {
          "type": "boolean"
        },
        "error_code": {
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    }
  }
}
